import("animax.gni")

group("animax_core") {
  deps = [
    "../include",
    "animation",
    "animator",
    "audio",
    "base",
    "content",
    "layer",
    "model",
    "parser",
    "player",
    "property",
    "render",
    "resource",
    "video",
  ]
}

source_set("animax") {
  deps = [
    ":animax_core",
    "render:skity",
  ]
}

config("animax_private_config") {
  include_dirs = [
    ".",
    "..",
    animax_proj_root,
    lynx_base_search_path,
    rapidjson_include_path,
    "$skity_search_path/include",
    "$skity_search_path/third_party/glm",
    "$textra_search_path/public",
  ]

  if (is_win || is_linux) {
    include_dirs += [ "//third_party/angle/include" ]
  }

  cflags = [
    "-Wno-c99-designator",
    "-Wno-unknown-warning-option",
    "-Wno-sign-compare",
    "-Wno-unused-but-set-variable",
    "-Wno-unused-parameter",
    "-Wno-unused-private-field",
    "-Wno-unused-variable",
    "-Wno-unused-result",
  ]
  cflags_cc = []
  defines = [ "RAPIDJSON_HAS_STDSTRING=1" ]

  if (!is_debug) {
    defines += [
      "ANIMAX_MIN_LOG_LEVEL=2",
      "NDEBUG",
    ]
  }

  # Shared by android and harmony
  if (is_android || is_harmony) {
    defines += [
      "ENABLE_OPENGLES3=1",
      "NAPI_DISABLE_CPP_EXCEPTIONS",
      "NAPI_DISABLE_CPP_RTTI",
      "GNU_SUPPORT=1",
    ]

    if (is_debug) {
      defines += [ "ENABLE_LOGGING=1" ]
    } else {
      defines += [ "ENABLE_LOGGING=0" ]
    }

    # This flags are set by default when build with cmake
    cflags += [
      "-fstack-protector-strong",
      "-no-canonical-prefixes",
      "-fno-limit-debug-info",
    ]
    cflags += [ "-Oz" ]
    if (!is_asan) {
      cflags += [ "-fno-sanitize=safe-stack" ]
    }
    if (!is_debug) {
      cflags += [ "-faddrsig" ]
    }
  }

  if (is_android) {
    if (is_debug) {
      defines += [ "DEBUG_MEMORY" ]
    }

    defines += [
      "GNU_SUPPORT=1",
      "OS_ANDROID=1",
      "OS_POSIX=1",
    ]
    cflags += [
      "-fvisibility=hidden",
      "-fvisibility-inlines-hidden",
      "-fno-short-enums",
      "-Wall",
      "-fno-strict-aliasing",
      "-Wno-unused-function",
      "-Wno-pessimizing-move",
      "-Wno-unused-const-variable",
    ]
    cflags_cc += [
      "-std=c++17",
      "-fno-rtti",
      "-fno-exceptions",
    ]
    if (is_asan) {
      cflags += [ "-fno-omit-frame-pointer" ]
    } else {
      cflags += [
        "-fomit-frame-pointer",
        "-fno-sanitize=safe-stack",
      ]
    }
    if (!is_debug) {
      cflags += [ "-faddrsig" ]
      if (enable_lto) {
        cflags += [ "-flto" ]
      }
    }
  } else if (is_ios) {
    defines += [
      "OS_IOS=1",
      "OS_POSIX=1",
    ]
  } else if (is_harmony) {
    defines += [ "OS_HARMONY=1" ]
  } else if (is_win) {
    defines += [
      "OS_WIN=1",
      "NAPI_DISABLE_CPP_RTTI",
      "BASE_NO_EXPORT",
    ]
    cflags += [ "/EHsc" ]
  } else if (is_mac) {
    defines += [
      "OS_OSX=1",
      "OS_POSIX=1",
    ]
    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Metal.framework",
      "VideoToolbox.framework",
    ]
  } else if (is_linux) {
    defines += [
      "OS_LINUX=1",
      "NAPI_DISABLE_CPP_RTTI",
    ]
  } else if (is_wasm) {
    defines += [
      "OS_WASM=1",
      "ENABLE_TEXT_RENDER",
      "SKITY_CPU=1",
      "SKITY_OPENGL=1",
    ]
    if (is_debug) {
      cflags_cc += [ "-gsource-map" ]
    }
    cflags_cc += [ "--use-port=emdawnwebgpu" ]
  }

  if (use_primjs_napi) {
    defines += [ "USE_PRIMJS_NAPI" ]
  }

  if (enable_trace == "perfetto") {
    defines += [ "ENABLE_TRACE_PERFETTO=1" ]
  } else if (enable_trace == "systrace") {
    defines += [ "ENABLE_TRACE_SYSTRACE=1" ]
  }
}

config("animax_public_config") {
  defines = []
  include_dirs = [ ".." ]
  if (!is_debug) {
    defines += [ "ANIMAX_MIN_LOG_LEVEL=2" ]
  }
}
