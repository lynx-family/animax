From cbd0ebcbcfd63de8b671b12a00c7e46ec6dd35e4 Mon Sep 17 00:00:00 2001
From: "yuyang.1024" <yuyang.1024@bytedance.com>
Date: Tue, 17 Nov 2026 15:56:14 +0800
Subject: [PATCH] [Optimize] Avoid scalar loops in byte-array vector copies

Choose libc++-compatible input iterators for byte-vector copies across
platform bridges and embedder paths to preserve bulk copying and avoid
redundant zero initialization, with a header backport for standalone
AnimaX builds.

TEST: Initial arm64/arm64e assembly and focused UBSan checks passed;
restoration passed formatting, diff and dependency-patch consistency
checks; no build or test rerun after restoration.

AutoLand: release/4.5, release/4.4, release_4.4_weekly_20261116

SkipChecks: macro

diff --git a/base/include/byte_utils.h b/base/include/byte_utils.h
new file mode 100644
index 00000000000..04cbac5b537
--- /dev/null
+++ b/base/include/byte_utils.h
@@ -0,0 +1,48 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+#ifndef BASE_INCLUDE_BYTE_UTILS_H_
+#define BASE_INCLUDE_BYTE_UTILS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace lynx {
+namespace base {
+
+// Copies readable bytes without first value-initializing the destination.
+// The source must not overlap the destination. For size 0, it may be null.
+inline void AssignByteArray(std::vector<uint8_t>& destination, const void* data,
+                            size_t size) {
+  if (size == 0) {
+    destination.clear();
+    return;
+  }
+
+  const auto* bytes = static_cast<const uint8_t*>(data);
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION >= 200000
+  // libc++ 20's uninitialized allocator copy checks trivial copy assignment
+  // of the input type without removing const, disabling bulk copy for
+  // const uint8_t*.
+  // assign only reads the source, even when the iterator type is mutable.
+  auto* begin = const_cast<uint8_t*>(bytes);
+#else
+  // Older libc++ versions (including 15 and 17) select their bulk-copy
+  // specialization only for const input pointers.
+  const auto* begin = bytes;
+#endif
+  destination.assign(begin, begin + size);
+}
+
+inline std::vector<uint8_t> CopyByteArray(const void* data, size_t size) {
+  std::vector<uint8_t> result;
+  AssignByteArray(result, data, size);
+  return result;
+}
+
+}  // namespace base
+}  // namespace lynx
+
+#endif  // BASE_INCLUDE_BYTE_UTILS_H_
