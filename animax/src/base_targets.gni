import("//build_overrides/darwin.gni")

animax_private_config = rebase_path(":animax_private_config")
animax_public_config = rebase_path(":animax_public_config")

template("animax_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                             "public_configs",
                           ])

    if (!defined(deps)) {
      deps = []
    }
    if (!defined(configs)) {
      configs = []
    }
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
    if (!defined(public_configs)) {
      public_configs = []
    }
    if (defined(invoker.public_configs)) {
      public_configs += invoker.public_configs
    }

    configs += [ animax_private_config ]
    public_configs += [ animax_public_config ]
    if (is_android) {
      if (!defined(libs)) {
        libs = []
      }
      libs += [ "log" ]
    } else if (is_apple) {
      configs += darwin_config
    }

    if (defined(exclude_configs)) {
      configs -= exclude_configs
    }
    if (defined(exclude_deps)) {
      deps -= exclude_deps
    }
    if (defined(exclude_public_configs)) {
      public_configs -= exclude_public_configs
    }
  }
}
