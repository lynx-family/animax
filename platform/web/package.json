{
  "name": "@byted-lynx/animax",
  "version": "1.0.8",
  "description": "AnimaX for web platform",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "files": [
    "out",
    "public",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:wasm": "python3 ../../tools/build_wasm.py -t Debug",
    "build:wasm-release": "python3 ../../tools/build_wasm.py -t Release",
    "clean": "rm -rf out && rm -rf public",
    "build:types": "tsc",
    "build": "npm run clean && npm run build:wasm-release && npm run build:types",
    "build:release": "npm run build",
    "build:debug": "npm run clean && npm run build:wasm && npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "https://code.byted.org/lynx/template-assembler"
  },
  "keywords": [
    "AnimaX",
    "Lottie",
    "WebAssembly"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rspack/cli": "^1.7.0",
    "@rspack/core": "^1.7.0",
    "@webgpu/types": "^0.1.67",
    "typescript": "^5.1.6"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "publishConfig": {
    "registry": "https://bnpm.byted.org/"
  }
}