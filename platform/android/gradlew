set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
java_cmd="${JAVA_HOME:+$JAVA_HOME/bin/}java"

exec "$java_cmd" \
  -Dorg.gradle.appname=gradlew \
  -classpath "$script_dir/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
