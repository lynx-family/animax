import("AnimaXNapi.gni")

cmake_target("AnimaXNapi") {
  cmake_version = "3.4.1"
  target_type = "shared_library"
  output_name = "animax_napi"

  deps = [
    ":animax_napi_jni_files",
    "../../../src/jsbridge",
    "../animax_android:AnimaXAndroid",
  ]

  lib_dirs = [
    "${lynx_base_native_lib_dir}",
    "${primjs_native_lib_dir}",
  ]
  libs = [
    "napi",
    "EGL",
    "GLESv3",
    "android",
    "dl",
    "log",
    "lynxbase",
    "jnigraphics",
  ]

  ldflags = []
  if (!is_debug) {
    ldflags += [
      "-O2",
      "-Wl,--icf=all",
    ]
    if (enable_lto) {
      ldflags += [ "-flto" ]
    }
  }
  ldflags += [
    "-fno-limit-debug-info",
    "-Wl,--exclude-libs,ALL,--gc-sections",
    "-Xlinker",
    "-Map=output.map",
  ]
  configs = [ "../../../platform/android:16kb_page" ]
}

group("animax_napi_jni_files") {
  exec_script(
      "../../../buildtools/tools_shared/tools_shared/jni_generator/generate_and_register_jni_files.py",
      [
        "-root",
        rebase_path("//"),
        "-path",
        rebase_path("./src/main/jni/jni_configs.yml"),
        "--use-base-jni-header",
      ])
  public_deps = [ "src/main/jni:build" ]
}
