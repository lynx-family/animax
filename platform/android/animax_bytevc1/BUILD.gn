import("../../../../core/Lynx.gni")
import("AnimaXByteVc1.gni")

cmake_target("AnimaXByteVc1") {
  cmake_version = "3.4.1"
  target_type = "shared_library"
  output_name = "animax_bytevc1"
  deps = [
    "../../../src:animax_bytevc1",
    "../animax_android:AnimaXAndroid",
  ]
  lib_dirs = []
  libs = [
    "android",
    "dl",
    "log",
    "GLESv3",
  ]
  ldflags = []
  if (!is_debug) {
    ldflags += [
      "-O2",
      "-Wl,--icf=all",
    ]
    if (enable_lto) {
      ldflags += [ "-flto" ]
    }
  }
  ldflags += [
    "-fno-limit-debug-info",
    "-Wl,--exclude-libs,ALL,--gc-sections",
    "-Xlinker",
    "-Map=output.map",
  ]
  configs = [ "../../../../lynx/platform/android:16kb_page" ]
}
