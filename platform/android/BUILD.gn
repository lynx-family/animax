assert(is_android)

import("//build_overrides/animax.gni")
import("//config.gni")

config("16kb_page") {
  ldflags = []
  if (enable_16kb_align &&
      (android_app_abi == "arm64-v8a" || android_app_abi == "x86_64")) {
    ldflags += [
      "-Wl,-z,max-page-size=16384",
      "-fuse-ld=lld",
    ]
  }
}

group("Android") {
  deps = [
    "../../third_party/lynx-textra/platform/android/lynxtextra:lynxtextra",
    "../../third_party/lynx/base/platform/android:LynxBase",
    "../../third_party/lynx/base/trace/android:LynxTrace",
    "./animax_android:AnimaXAndroid",
    "./animax_textra:AnimaXTextra",
  ]

  if (enable_napi) {
    deps += [ "./animax_napi:AnimaXNapi" ]
  }
}
