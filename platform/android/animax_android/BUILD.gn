import("../../../../core/Lynx.gni")
import("../../../animax/src/animax.gni")
import("AnimaXAndroid.gni")

cmake_target("AnimaXAndroid") {
  cmake_version = "3.4.1"
  target_type = "shared_library"
  output_name = "animax"

  deps = [
    ":animax_jni_files",
    "../../../../animax/animax/src:animax",
    "../../../../base/platform/android:LynxBase",
    "../../../../base/trace/android:LynxTrace",
  ]
  lib_dirs = []
  libs = [
    "EGL",
    "GLESv3",
    "android",
    "dl",
    "log",
    "jnigraphics",
  ]

  ldflags = []
  if (!is_debug) {
    ldflags += [
      "-O2",
      "-Wl,--icf=all",
    ]
    if (enable_lto) {
      ldflags += [ "-flto" ]
    }
  }
  ldflags += [
    "-fno-limit-debug-info",
    "-Wl,--exclude-libs,ALL,--gc-sections",
    "-Xlinker",
    "-Map=output.map",
  ]
  configs = [ "../../../../lynx/platform/android:16kb_page" ]

  if (enable_animax_android_testing) {
    deps += [
      "../../../../animax/testing:animax_android_unittests",
      "../../../../animax/testing:gtest_testing_animax_android",
      "//third_party/googletest:gtest_sources",
      "//third_party/googletest_custom:gtest_custom",
    ]
  }
}

group("animax_jni_files") {
  exec_script("//tools_shared/jni_generator/generate_and_register_jni_files.py",
              [
                "-root",
                rebase_path("//"),
                "-path",
                rebase_path("./src/main/jni/jni_configs.yml"),
                "--use-base-jni-header",
              ])
  public_deps = [ "src/main/jni:build" ]
}
