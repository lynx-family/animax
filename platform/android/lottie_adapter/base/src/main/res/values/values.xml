<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr format="string" name="lottie_fileName"/>
    <attr format="reference" name="lottie_rawRes"/>
    <attr format="string" name="lottie_url"/>
    <attr format="boolean" name="lottie_autoPlay"/>
    <attr format="boolean" name="lottie_loop"/>
    <attr format="enum" name="lottie_adapter_repeatMode">
        <enum name="restart" value="1"/>
        <enum name="reverse" value="2"/>
    </attr>
    <attr format="integer" name="lottie_repeatCount"/>
    <attr format="string" name="lottie_imageAssetsFolder"/>
    <attr format="float" name="lottie_progress"/>
    <attr format="boolean" name="lottie_enableMergePathsForKitKatAndAbove"/>
    <attr format="enum" name="lottie_adapter_cacheStrategy">
        <enum name="none" value="0"/>
        <enum name="weak" value="1"/>
        <enum name="strong" value="2"/>
    </attr>
    <attr format="enum" name="lottie_adapter_type">
        <enum name="lottie" value="0" />
        <enum name="animax" value="1" />
    </attr>
    <attr format="color" name="lottie_colorFilter"/>
    <attr format="float" name="lottie_scale"/>
    <attr format="boolean" name="lottie_lazyLoad"/>
    <attr format="boolean" name="lottie_adapter_useImageMode"/>
    <attr format="boolean" name="lottie_adapter_multiThreadAccelerate"/>

    <declare-styleable name="LottieAdapterView">
        <attr name="lottie_fileName"/>
        <attr name="lottie_rawRes"/>
        <attr name="lottie_url"/>
        <attr name="lottie_autoPlay"/>
        <attr name="lottie_loop"/>
        <attr name="lottie_adapter_repeatMode"/>
        <attr name="lottie_repeatCount"/>
        <attr name="lottie_imageAssetsFolder"/>
        <attr name="lottie_progress"/>
        <attr name="lottie_enableMergePathsForKitKatAndAbove"/>
        <attr name="lottie_adapter_cacheStrategy"/>
        <attr name="lottie_adapter_type"/>
        <attr name="lottie_adapter_useImageMode"/>
        <attr name="lottie_adapter_multiThreadAccelerate"/>
        <attr name="lottie_colorFilter"/>
        <attr name="lottie_scale"/>
        <attr name="lottie_lazyLoad"/>
        <attr name="android:scaleType" />
    </declare-styleable>
</resources>